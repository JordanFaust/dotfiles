#!/usr/bin/env bash
# Catppuccin Macchiato sketchybar configuration
# Layout: center [workspaces] | right [network] [battery] [clock]

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Ensure plugin scripts are executable after nix store copy
chmod +x "$PLUGIN_DIR"/*.sh 2>/dev/null || true

############################################################
# Colors — Catppuccin Macchiato
############################################################
BASE=0xff24273a
SURFACE0=0xff363a4f
SURFACE1=0xff494d64
OVERLAY0=0xff6e738d
TEXT=0xffcad3f5
ROSEWATER=0xfff4dbd6
YELLOW=0xffeed49f
BLUE=0xff8aadf4
GREEN=0xffa6da95

############################################################
# Bar appearance
############################################################
sketchybar --bar \
  height=36 \
  position=top \
  sticky=true \
  padding_left=12 \
  padding_right=12 \
  color=$BASE \
  border_width=0 \
  margin=0 \
  y_offset=0 \
  corner_radius=0 \
  topmost=window \
  notch_width=0

############################################################
# Default item appearance
############################################################
sketchybar --default \
  icon.font="MonoLisa Variable Regular:Regular:13.0" \
  label.font="MonoLisa Variable Regular:Regular:13.0" \
  icon.color=$TEXT \
  label.color=$TEXT \
  icon.padding_left=6 \
  icon.padding_right=4 \
  label.padding_left=4 \
  label.padding_right=6 \
  background.corner_radius=6 \
  background.height=26

############################################################
# AeroSpace workspace event
############################################################
sketchybar --add event aerospace_workspace_change

############################################################
# Workspaces — center (mirrors hyprpanel layout)
############################################################
for sid in 1 2 3 4 5; do
  sketchybar --add item "space.$sid" center \
    --set "space.$sid" \
      icon="$sid" \
      icon.font="MonoLisa Variable Regular:Bold:14.0" \
      icon.color=$OVERLAY0 \
      label.drawing=off \
      background.color=$SURFACE0 \
      background.corner_radius=6 \
      background.height=26 \
      background.padding_left=2 \
      background.padding_right=2 \
      script="$PLUGIN_DIR/aerospace.sh $sid" \
      click_script="aerospace workspace $sid" \
    --subscribe "space.$sid" aerospace_workspace_change
done

############################################################
# Right side — clock, battery, network (rightmost first)
############################################################

# Clock
sketchybar --add item clock right \
  --set clock \
    icon="󰥔" \
    icon.color=$ROSEWATER \
    update_freq=1 \
    script="$PLUGIN_DIR/clock.sh"

# Battery
sketchybar --add item battery right \
  --set battery \
    update_freq=120 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke

# Network
sketchybar --add item network right \
  --set network \
    update_freq=30 \
    script="$PLUGIN_DIR/network.sh"

############################################################
# Initial update
############################################################
sketchybar --update
